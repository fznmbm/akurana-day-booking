# AHHC Production Environment Variables
# Copy this to .env.local when deploying AHHC

# ============================================
# ORGANIZATION IDENTIFIER
# ============================================
NEXT_PUBLIC_ORG_ID=ahhc

# ============================================
# MONGODB CONNECTION
# ============================================
# TODO: Replace with your AHHC MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ahhc_events?retryWrites=true&w=majority

# ============================================
# APPLICATION URL
# ============================================
NEXT_PUBLIC_APP_URL=https://elitestack.co.uk/ahhc

# ============================================
# ADMIN AUTHENTICATION
# ============================================
# This is used to generate JWT tokens for admin login
# IMPORTANT: Change this to a random string in production
JWT_SECRET=change-this-to-random-secret-for-ahhc-production

# ============================================
# OPTIONAL: THIRD-PARTY SERVICES
# ============================================
# Uncomment and configure if using these services

# SendGrid Email (for confirmation emails - future feature)
# SENDGRID_API_KEY=your_sendgrid_api_key

# Twilio SMS (for SMS notifications - future feature)  
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+44XXXXXXXXXX

# ============================================
# VERCEL CONFIGURATION (Auto-configured)
# ============================================
# These are set automatically by Vercel, no need to configure
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-project.vercel.app
